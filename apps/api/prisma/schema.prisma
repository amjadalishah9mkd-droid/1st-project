// CampusOS — Prisma schema (Blueprint v1.0 §1–§4, source of truth alignment)
// Conventions: cuid PKs, createdAt/updatedAt everywhere, tenant-safe collegeId
// on all aggregate roots, composite unique constraints scoped by collegeId.
// Delete policies: Restrict on academic/financial references, Cascade only on
// pure children, SetNull on optional actor references.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────── Enums ────────────────────────────

enum RoleKey {
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum PermissionScope {
  OWN
  ASSIGNED
  DEPARTMENT
  ALL
}

enum StudentStatus {
  ENROLLED
  GRADUATED
  WITHDRAWN
  SUSPENDED
}

enum CourseStatus {
  ACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  COMPLETED
}

enum SessionStatus {
  SCHEDULED
  HELD
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ExamType {
  QUIZ
  MIDTERM
  FINAL
  PRACTICAL
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  PUBLISHED
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum PostType {
  GENERAL
  RESOURCE
  ACHIEVEMENT
  EVENT_SHARE
}

enum ContentStatus {
  ACTIVE
  REMOVED_BY_AUTHOR
  REMOVED_BY_MODERATOR
}

enum GroupPrivacy {
  OPEN
  REQUEST
}

enum GroupRole {
  MEMBER
  MODERATOR
}

enum MembershipStatus {
  ACTIVE
  PENDING
}

enum GroupStatus {
  ACTIVE
  ARCHIVED
}

enum SocietyCategory {
  TECHNICAL
  CULTURAL
  SPORTS
  LITERARY
  SOCIAL
  OTHER
}

enum SocietyRole {
  MEMBER
  OFFICER
  PRESIDENT
}

enum SocietyStatus {
  ACTIVE
  ARCHIVED
}

enum EventStatus {
  ACTIVE
  CANCELLED
  REMOVED
}

enum RsvpStatus {
  GOING
  INTERESTED
  DECLINED
}

enum ReportTargetType {
  POST
  COMMENT
  USER
  EVENT
  RESOURCE
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE
  MISINFORMATION
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  REMOVE_CONTENT
  RESTORE_CONTENT
  WARN_USER
  SUSPEND_COMMUNITY
  LIFT_SUSPENSION
}

enum AnnouncementScope {
  ALL
  ROLE
  DEPARTMENT
  SECTION
}

// ──────────────────────── Tenant Root ──────────────────────────

model College {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  academicYears    AcademicYear[]
  terms            Term[]
  departments      Department[]
  courses          Course[]
  sections         Section[]
  teacherProfiles  TeacherProfile[]
  studentProfiles  StudentProfile[]
  exams            Exam[]
  gradeBands       GradeBand[]
  feeStructures    FeeStructure[]
  invoices         Invoice[]
  posts            Post[]
  groups           Group[]
  societies        Society[]
  events           Event[]
  resources        Resource[]
  reports          Report[]
  moderationActions ModerationAction[]
  announcements    Announcement[]
  auditLogs        AuditLog[]
}

// ────────────────────── Identity & Access ──────────────────────

model User {
  id                 String     @id @default(cuid())
  collegeId          String
  email              String
  passwordHash       String
  role               RoleKey
  status             UserStatus @default(ACTIVE)
  firstName          String
  lastName           String
  phone              String?
  avatarUrl          String?
  mustChangePassword Boolean    @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Restrict)

  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  refreshTokens  RefreshToken[]
  notifications  Notification[]

  sessionsTaken     ClassSession[]     @relation("SessionTakenBy")
  attendanceMarked  AttendanceRecord[] @relation("AttendanceMarkedBy")
  assignmentsCreated Assignment[]      @relation("AssignmentCreatedBy")
  submissionsGraded Submission[]       @relation("SubmissionGradedBy")
  examsPublished    Exam[]             @relation("ExamPublishedBy")
  marksEntered      Mark[]             @relation("MarkEnteredBy")
  paymentsRecorded  Payment[]          @relation("PaymentRecordedBy")
  posts             Post[]             @relation("PostAuthor")
  comments          Comment[]          @relation("CommentAuthor")
  likes             Like[]
  groupsCreated     Group[]            @relation("GroupCreatedBy")
  groupMemberships  GroupMember[]
  societyMemberships SocietyMember[]
  eventsCreated     Event[]            @relation("EventCreatedBy")
  eventRsvps        EventRsvp[]
  resourcesUploaded Resource[]         @relation("ResourceUploader")
  reportsFiled      Report[]           @relation("ReportReporter")
  reportsResolved   Report[]           @relation("ReportResolvedBy")
  moderationActionsTaken ModerationAction[] @relation("ModerationActor")
  moderationActionsAgainst ModerationAction[] @relation("ModerationTargetUser")
  announcementsAuthored Announcement[] @relation("AnnouncementAuthor")
  auditLogs         AuditLog[]         @relation("AuditActor")

  @@unique([collegeId, email])
  @@index([collegeId, role])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String          @id @default(cuid())
  role         RoleKey
  permissionId String
  scope        PermissionScope
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// ───────────────────── Academic Structure ──────────────────────

model AcademicYear {
  id        String   @id @default(cuid())
  collegeId String
  label     String
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  terms   Term[]

  @@unique([collegeId, label])
}

model Term {
  id             String   @id @default(cuid())
  collegeId      String
  academicYearId String
  label          String
  startsOn       DateTime @db.Date
  endsOn         DateTime @db.Date
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  college      College      @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  sections      Section[]
  exams         Exam[]
  feeStructures FeeStructure[]

  @@unique([academicYearId, label])
  @@index([collegeId, isCurrent])
}

model Department {
  id            String   @id @default(cuid())
  collegeId     String
  name          String
  code          String
  headTeacherId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  college     College         @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  headTeacher TeacherProfile? @relation("DepartmentHead", fields: [headTeacherId], references: [id], onDelete: SetNull)

  courses         Course[]
  teacherProfiles TeacherProfile[]
  studentProfiles StudentProfile[]

  @@unique([collegeId, code])
}

model Course {
  id           String       @id @default(cuid())
  collegeId    String
  departmentId String
  code         String
  title        String
  credits      Int
  description  String?
  status       CourseStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  college    College    @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  sections      Section[]
  feeStructures FeeStructure[]
  resources     Resource[]

  @@unique([collegeId, code])
  @@index([departmentId])
}

model Section {
  id        String   @id @default(cuid())
  collegeId String
  courseId  String
  termId    String
  name      String
  capacity  Int
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  term    Term    @relation(fields: [termId], references: [id], onDelete: Restrict)

  enrollments         Enrollment[]
  teachingAssignments TeachingAssignment[]
  timetableSlots      TimetableSlot[]
  classSessions       ClassSession[]
  assignments         Assignment[]
  examPapers          ExamPaper[]

  @@unique([courseId, termId, name])
  @@index([termId])
}

model TeacherProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  collegeId     String
  departmentId  String
  employeeNo    String
  designation   String
  qualification String?
  joinedOn      DateTime @db.Date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  college    College    @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  headOfDepartments   Department[]         @relation("DepartmentHead")
  teachingAssignments TeachingAssignment[]
  advisedSocieties    Society[]            @relation("SocietyAdvisor")

  @@unique([collegeId, employeeNo])
  @@index([departmentId])
}

model StudentProfile {
  id            String        @id @default(cuid())
  userId        String        @unique
  collegeId     String
  departmentId  String
  admissionNo   String
  rollNo        String
  batch         String
  dateOfBirth   DateTime?     @db.Date
  guardianName  String?
  guardianPhone String?
  guardianEmail String?
  address       String?
  status        StudentStatus @default(ENROLLED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  college    College    @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]
  submissions       Submission[]
  marks             Mark[]
  invoices          Invoice[]

  @@unique([collegeId, admissionNo])
  @@index([departmentId])
  @@index([collegeId, batch])
}

model Enrollment {
  id         String           @id @default(cuid())
  studentId  String
  sectionId  String
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section Section        @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@unique([studentId, sectionId])
  @@index([sectionId, status])
}

model TeachingAssignment {
  id        String   @id @default(cuid())
  teacherId String
  sectionId String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([teacherId, sectionId])
  @@index([sectionId])
}

// ──────────────────── Scheduling & Attendance ──────────────────

model TimetableSlot {
  id        String   @id @default(cuid())
  sectionId String
  dayOfWeek Int // 1 = Monday … 7 = Sunday
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section  Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sessions ClassSession[]

  @@index([sectionId, dayOfWeek])
}

model ClassSession {
  id        String        @id @default(cuid())
  slotId    String
  sectionId String // denormalized for roster/summary queries
  date      DateTime      @db.Date
  status    SessionStatus @default(SCHEDULED)
  takenById String?
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  slot    TimetableSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  section Section       @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  takenBy User?         @relation("SessionTakenBy", fields: [takenById], references: [id], onDelete: SetNull)

  attendanceRecords AttendanceRecord[]

  @@unique([slotId, date])
  @@index([sectionId, date])
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  sessionId  String
  studentId  String
  status     AttendanceStatus
  markedById String
  note       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  session  ClassSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student  StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy User           @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: Restrict)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

// ─────────────────────────── Assessment ────────────────────────

model Assignment {
  id          String    @id @default(cuid())
  sectionId   String
  title       String
  description String
  attachments Json      @default("[]")
  dueAt       DateTime
  maxPoints   Decimal   @db.Decimal(10, 2)
  allowLate   Boolean   @default(false)
  createdById String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdBy User    @relation("AssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  submissions Submission[]

  @@index([sectionId, dueAt])
}

model Submission {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  textContent  String?
  fileUrl      String?
  fileName     String?
  submittedAt  DateTime  @default(now())
  isLate       Boolean   @default(false)
  points       Decimal?  @db.Decimal(10, 2)
  feedback     String?
  gradedById   String?
  gradedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignment Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy   User?          @relation("SubmissionGradedBy", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model Exam {
  id            String     @id @default(cuid())
  collegeId     String
  termId        String
  title         String
  type          ExamType
  status        ExamStatus @default(DRAFT)
  publishedAt   DateTime?
  publishedById String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  college     College @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  term        Term    @relation(fields: [termId], references: [id], onDelete: Restrict)
  publishedBy User?   @relation("ExamPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  papers ExamPaper[]

  @@index([termId, status])
}

model ExamPaper {
  id        String   @id @default(cuid())
  examId    String
  sectionId String
  examDate  DateTime
  maxMarks  Decimal  @db.Decimal(10, 2)
  weight    Decimal  @default(1) @db.Decimal(10, 2) // dormant GPA hook
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  marks Mark[]

  @@unique([examId, sectionId])
  @@index([sectionId])
}

model Mark {
  id            String    @id @default(cuid())
  examPaperId   String
  studentId     String
  marksObtained Decimal   @db.Decimal(10, 2)
  enteredById   String
  lockedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  examPaper ExamPaper      @relation(fields: [examPaperId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enteredBy User           @relation("MarkEnteredBy", fields: [enteredById], references: [id], onDelete: Restrict)

  @@unique([examPaperId, studentId])
  @@index([studentId])
}

model GradeBand {
  id         String   @id @default(cuid())
  collegeId  String
  label      String
  minPercent Decimal  @db.Decimal(5, 2)
  maxPercent Decimal  @db.Decimal(5, 2)
  gradePoint Decimal? @db.Decimal(4, 2) // dormant GPA hook
  sortOrder  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Restrict)

  @@unique([collegeId, label])
}

// ────────────────────────────── Fees ───────────────────────────

model FeeStructure {
  id          String   @id @default(cuid())
  collegeId   String
  termId      String
  courseId    String?
  name        String
  totalAmount Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  term    Term    @relation(fields: [termId], references: [id], onDelete: Restrict)
  course  Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)

  components FeeComponent[]
  invoices   Invoice[]

  @@index([termId])
}

model FeeComponent {
  id          String   @id @default(cuid())
  structureId String
  label       String
  amount      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  structure FeeStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@index([structureId])
}

model Invoice {
  id          String        @id @default(cuid())
  collegeId   String
  studentId   String
  structureId String
  invoiceNo   String
  amount      Decimal       @db.Decimal(10, 2)
  dueDate     DateTime      @db.Date
  status      InvoiceStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  college   College        @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  structure FeeStructure   @relation(fields: [structureId], references: [id], onDelete: Restrict)

  payments Payment[]

  @@unique([collegeId, invoiceNo])
  @@index([studentId, status])
}

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod
  reference    String?
  paidAt       DateTime
  recordedById String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy User    @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}

// ─────────────────────────── Community ─────────────────────────

model Post {
  id           String        @id @default(cuid())
  collegeId    String
  authorId     String
  type         PostType      @default(GENERAL)
  body         String
  attachments  Json          @default("[]")
  groupId      String?
  societyId    String?
  resourceId   String?
  eventId      String?
  status       ContentStatus @default(ACTIVE)
  likeCount    Int           @default(0)
  commentCount Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  college  College   @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  author   User      @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  group    Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  society  Society?  @relation(fields: [societyId], references: [id], onDelete: SetNull)
  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  event    Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)

  comments Comment[]
  likes    Like[]

  @@index([collegeId, status, createdAt])
  @@index([groupId])
  @@index([societyId])
}

model Comment {
  id        String        @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  body      String
  status    ContentStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  post   Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  parent Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)

  replies Comment[] @relation("CommentReplies")
  likes   Like[]

  @@index([postId, status])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String?
  commentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
}

model Group {
  id          String       @id @default(cuid())
  collegeId   String
  name        String
  description String
  coverUrl    String?
  privacy     GroupPrivacy @default(OPEN)
  createdById String
  status      GroupStatus  @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  college   College @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  createdBy User    @relation("GroupCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  members GroupMember[]
  posts   Post[]

  @@unique([collegeId, name])
}

model GroupMember {
  id        String           @id @default(cuid())
  groupId   String
  userId    String
  role      GroupRole        @default(MEMBER)
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model Society {
  id               String          @id @default(cuid())
  collegeId        String
  name             String
  category         SocietyCategory
  description      String
  logoUrl          String?
  facultyAdvisorId String?
  status           SocietyStatus   @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  college        College         @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  facultyAdvisor TeacherProfile? @relation("SocietyAdvisor", fields: [facultyAdvisorId], references: [id], onDelete: SetNull)

  members SocietyMember[]
  events  Event[]
  posts   Post[]

  @@unique([collegeId, name])
}

model SocietyMember {
  id        String           @id @default(cuid())
  societyId String
  userId    String
  role      SocietyRole      @default(MEMBER)
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([societyId, userId])
  @@index([userId])
}

model Event {
  id          String      @id @default(cuid())
  collegeId   String
  societyId   String?
  title       String
  description String
  venue       String
  startsAt    DateTime
  endsAt      DateTime
  coverUrl    String?
  capacity    Int?
  createdById String
  status      EventStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  college   College  @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  society   Society? @relation(fields: [societyId], references: [id], onDelete: SetNull)
  createdBy User     @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  rsvps EventRsvp[]
  posts Post[]

  @@index([collegeId, startsAt])
}

model EventRsvp {
  id        String     @id @default(cuid())
  eventId   String
  userId    String
  status    RsvpStatus
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Resource {
  id            String        @id @default(cuid())
  collegeId     String
  uploaderId    String
  courseId      String?
  title         String
  description   String?
  fileUrl       String
  fileName      String
  fileType      String
  fileSize      Int
  downloadCount Int           @default(0)
  status        ContentStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  college  College @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  uploader User    @relation("ResourceUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  posts Post[]

  @@index([collegeId, status])
}

// ─────────────────────────── Moderation ────────────────────────

model Report {
  id             String           @id @default(cuid())
  collegeId      String
  reporterId     String
  targetType     ReportTargetType
  targetId       String
  reason         ReportReason
  details        String?
  status         ReportStatus     @default(OPEN)
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  college    College @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  reporter   User    @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  resolvedBy User?   @relation("ReportResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  moderationActions ModerationAction[]

  @@index([collegeId, status])
  @@index([targetType, targetId])
}

model ModerationAction {
  id           String               @id @default(cuid())
  collegeId    String
  reportId     String?
  actorId      String
  action       ModerationActionType
  targetType   ReportTargetType
  targetId     String
  targetUserId String?
  expiresAt    DateTime?
  note         String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  college    College @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  report     Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  actor      User    @relation("ModerationActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUser User?   @relation("ModerationTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId, action])
}

// ──────────────────────────── Platform ─────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  linkPath  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Announcement {
  id            String            @id @default(cuid())
  collegeId     String
  authorId      String
  title         String
  body          String
  audienceScope AnnouncementScope
  audienceIds   Json              @default("[]")
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  author  User    @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([collegeId, publishedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  collegeId  String
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Restrict)
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([collegeId, createdAt])
}
