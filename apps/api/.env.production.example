# CampusOS API — production environment template (M10-W3).
# Copy to the deployment host; NEVER commit real values.
# All three secrets are REQUIRED in production and must be >= 32 chars.
# Generate with: openssl rand -hex 32

NODE_ENV=production

# Postgres connection (use a dedicated user, not the superuser).
DATABASE_URL=postgresql://campusos:<STRONG_DB_PASSWORD>@postgres:5432/campusos

API_PORT=4000

# Access-token signing secret (JWT, 15 min TTL).
JWT_ACCESS_SECRET=
# Refresh-token family secret (reserved; rotation uses hashed opaque tokens).
JWT_REFRESH_SECRET=
# HMAC secret for signed, expiring file-download URLs.
FILE_URL_SECRET=

# Comma-separated browser origins allowed to call the API cross-origin.
# Leave unset when the web app is served same-origin behind one proxy.
# CORS_ORIGINS=https://campus.example.edu

# Persistent uploads directory (mount a backed-up volume here).
UPLOAD_DIR=/data/uploads

# Demo seed must never run in production. Do not set SEED_DEMO here.
# ALLOW_DEMO_SEED is an explicit break-glass override for staging only.
