# CampusOS API — production environment template (M10-W3).
# Copy to the deployment host; NEVER commit real values.
# All three secrets are REQUIRED in production and must be >= 32 chars.
# Generate with: openssl rand -hex 32

NODE_ENV=production

# Compose database password (generate a strong value). DATABASE_URL below is
# overridden by docker-compose.prod.yaml so the same password is used safely.
POSTGRES_PASSWORD=
# Direct/non-Compose connection (use a dedicated user, not the superuser).
DATABASE_URL=postgresql://campusos:<STRONG_DB_PASSWORD>@postgres:5432/campusos

API_PORT=4000

# Access-token signing secret (JWT, 15 min TTL).
JWT_ACCESS_SECRET=
# Refresh-token family secret (reserved; rotation uses hashed opaque tokens).
JWT_REFRESH_SECRET=
# HMAC secret for signed, expiring file-download URLs.
FILE_URL_SECRET=

# Comma-separated browser origins allowed to call the API cross-origin.
# Leave unset when the web app is served same-origin behind one proxy.
# CORS_ORIGINS=https://campus.example.edu

# Persistent uploads directory (mount a backed-up volume here).
UPLOAD_DIR=/data/uploads

# Demo seed must never run in production. Do not set SEED_DEMO here.
# ALLOW_DEMO_SEED is an explicit break-glass override for staging only.

# Transactional email (M12-W1) — optional feature; leave unset to disable.
# SMTP_URL and MAIL_FROM must be set together.
# SMTP_URL=smtp://user:password@smtp.example.edu:587
# MAIL_FROM="CampusOS <no-reply@campus.example.edu>"
# Absolute base for links in emails (falls back to OAUTH_REDIRECT_BASE).
# APP_BASE_URL=https://campus.example.edu

# Google OIDC (optional) — all three must be set together.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OAUTH_REDIRECT_BASE=https://campus.example.edu

# Safepay online payments (optional) — API/SECRET must be set together.
# Webhook registration remains externally blocked; setting the webhook secret
# configures verification only and does not register an endpoint with Safepay.
# SAFEPAY_API_KEY=
# SAFEPAY_SECRET_KEY=
# SAFEPAY_ENVIRONMENT=production
# SAFEPAY_HOST=https://api.getsafepay.com
# SAFEPAY_INTENT=CYBERSOURCE
# SAFEPAY_WEBHOOK_SECRET=

# Published web port on the deployment host.
# WEB_PORT=3000

# M22-W3 backup policy is set in Compose: local pgbackups volume, one complete
# DB/uploads pair daily, 14-day retention, 5-minute failure retry. Off-host
# copies and PITR remain operator/deployment responsibilities.
